# Copy this file to .env and update the values below.
# Example PostgreSQL URL:
# DATABASE_URL=postgresql://username:password@localhost:5432/legitways

DATABASE_URL=
DB_SSL=false
PORT=3000

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=yourgmailaddress@gmail.com
SMTP_PASSWORD=your-16-character-app-password
SMTP_FROM=LegitWays <yourgmailaddress@gmail.com>